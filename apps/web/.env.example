# ==============================================================================
# Pharmacy Education Platform — Web Client Environment Configuration (.env.example)
# ==============================================================================

# Firebase Project Credentials (from Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Firebase App Check (reCAPTCHA v3 site key for production bot and abuse protection)
# In production, callable Cloud Functions will reject requests without an App Check token.
VITE_RECAPTCHA_V3_SITE_KEY=6LeIx0cqAAAAAPlaceholderRecaptchaV3KeyHere

# App Check Debug Token (Optional: For local development and staging test harnesses)
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# Firebase Local Emulator Configuration (Set to 'true' or '1' to connect client to emulators)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FUNCTIONS_EMULATOR_PORT=5001
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
