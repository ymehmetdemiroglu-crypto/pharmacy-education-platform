# Environment mode: test or live
DODO_ENV=test

# Test Mode Credentials (Standard Webhooks & API Keys)
DODO_PAYMENTS_API_KEY_TEST=${DODO_PAYMENTS_API_KEY_TEST}
DODO_PAYMENTS_WEBHOOK_KEY_TEST=${DODO_PAYMENTS_WEBHOOK_KEY_TEST}

# Live Mode Credentials (Used ONLY when DODO_ENV=live)
DODO_PAYMENTS_API_KEY_LIVE=${DODO_PAYMENTS_API_KEY_LIVE}
DODO_PAYMENTS_WEBHOOK_KEY_LIVE=${DODO_PAYMENTS_WEBHOOK_KEY_LIVE}

# Application Base URL
APP_BASE_URL=http://localhost:5173

# Optional: Custom Product ID Mappings (Test Mode)
# DODO_PRODUCT_MEDCHEM_MONTHLY=${DODO_PRODUCT_MEDCHEM_MONTHLY}
# DODO_PRODUCT_MEDCHEM_SEMESTER=${DODO_PRODUCT_MEDCHEM_SEMESTER}
# DODO_PRODUCT_MEDCHEM_ANNUAL=${DODO_PRODUCT_MEDCHEM_ANNUAL}
