# Environment mode: test or live
DODO_ENV=test

# Test Mode Credentials (Standard Webhooks & API Keys)
DODO_PAYMENTS_API_KEY_TEST=your_dodo_test_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY_TEST=whsec_your_test_webhook_key_here

# Live Mode Credentials (Used ONLY when DODO_ENV=live)
DODO_PAYMENTS_API_KEY_LIVE=your_dodo_live_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY_LIVE=whsec_your_live_webhook_key_here

# Application Base URL (Redirect destination after checkout)
APP_BASE_URL=http://localhost:5173

# Firebase App Check Enforcement (Set to 'false' to disable in staging/testing)
# In production, defaults to enforced outside of local emulators.
ENFORCE_APP_CHECK=true

# ==============================================================================
# Optional: Product ID Mappings (Defaults defined in functions/src/config.ts)
# ==============================================================================

# Course A: Medicinal Chemistry (Test Mode)
# DODO_PRODUCT_MEDCHEM_MONTHLY=pdt_test_mc_monthly
# DODO_PRODUCT_MEDCHEM_SEMESTER=pdt_test_mc_semester
# DODO_PRODUCT_MEDCHEM_ANNUAL=pdt_test_mc_annual

# Course A: Medicinal Chemistry (Live Mode)
# DODO_PRODUCT_LIVE_MEDCHEM_MONTHLY=pdt_live_mc_monthly
# DODO_PRODUCT_LIVE_MEDCHEM_SEMESTER=pdt_live_mc_semester
# DODO_PRODUCT_LIVE_MEDCHEM_ANNUAL=pdt_live_mc_annual

# Course B: Pharmacology (Test Mode)
# DODO_PRODUCT_PHARM_MONTHLY=pdt_test_ph_monthly
# DODO_PRODUCT_PHARM_SEMESTER=pdt_test_ph_semester
# DODO_PRODUCT_PHARM_ANNUAL=pdt_test_ph_annual

# Course B: Pharmacology (Live Mode)
# DODO_PRODUCT_LIVE_PHARM_MONTHLY=pdt_live_ph_monthly
# DODO_PRODUCT_LIVE_PHARM_SEMESTER=pdt_live_ph_semester
# DODO_PRODUCT_LIVE_PHARM_ANNUAL=pdt_live_ph_annual

# Dual Bundle (Test Mode)
# DODO_PRODUCT_DUAL_MONTHLY=pdt_test_dual_monthly
# DODO_PRODUCT_DUAL_SEMESTER=pdt_test_dual_semester
# DODO_PRODUCT_DUAL_ANNUAL=pdt_test_dual_annual

# Dual Bundle (Live Mode)
# DODO_PRODUCT_LIVE_DUAL_MONTHLY=pdt_live_dual_monthly
# DODO_PRODUCT_LIVE_DUAL_SEMESTER=pdt_live_dual_semester
# DODO_PRODUCT_LIVE_DUAL_ANNUAL=pdt_live_dual_annual
